// Prisma schema for Personalize 2.0 data model
// Database connection is configured via the DATABASE_URL environment variable.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  free
  pro
  business
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique
  passwordHash        String           @map("password_hash")
  username            String           @unique
  subscriptionPlan    SubscriptionPlan @default(free) @map("subscription_plan")
  subscriptionStart   DateTime?        @map("subscription_start")
  subscriptionEnd     DateTime?        @map("subscription_end")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  personas            Persona[]
  projects            Project[]
  
  @@map("users")
}

model Project {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  name                String
  // metadata 可以存储 AI 总结后的知识库信息
  // 例如: { "summary": "...", "keyPoints": [...], "categories": [...] }
  metadata            Json?           @map("metadata")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets              ProjectAsset[]
  
  @@map("projects")
}

model ProjectAsset {
  id                  String          @id @default(uuid()) @db.Uuid
  projectId           String          @map("project_id") @db.Uuid
  name                String          // 文件名
  tosObjectKey        String          @map("tos_object_key") // TOS 存储路径
  // metadata 可以存储:
  // { 
  //   "fileType": "pdf|docx|txt",
  //   "fileSize": 1024,
  //   "textContent": "从 PDF 提取的纯文本内容",
  //   "extractedAt": "2024-01-01T00:00:00Z",
  //   "aiSummary": "AI 对这个文档的总结"
  // }
  metadata            Json?           @map("metadata")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("project_assets")
}

model Persona {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  name                      String
  avatarUrl                 String?  @map("avatar_url")
  domainTags                Json     @default("[]") @map("domain_tags")
  professionalBackground    Json?    @map("professional_background")
  expressionStyle           Json     @map("expression_style")
  audienceRelation          Json?    @map("audience_relation")
  professionalPreferences   Json?    @map("professional_preferences")
  isTemplate                Boolean  @default(false) @map("is_template")
  templateCategory          String?  @map("template_category")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("personas")
}

